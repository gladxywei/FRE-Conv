include .gitignore README.md README.zh-CN.md environment.yml CITATION.cff
include SOURCE_MANIFEST.json RELEASE_MANIFEST.json
include LICENSE THIRD_PARTY_NOTICES.md
recursive-include LICENSES *.txt
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
include data/README.md data/registry.yaml
include checkpoints/README.md checkpoints/manifest.json checkpoints/registry.yaml
include results/README.md results/icvl_paper_results.csv results/chikusei_aggregate.csv results/chikusei_per_mode.csv
global-exclude .DS_Store *.py[cod]
